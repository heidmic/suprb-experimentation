#!/usr/bin/env bash
# launch_grid.sh
# Startet einen SLURM-Job pro Grid-Kombination.
#
# Aufruf Grid:
#   bash launch_grid.sh [DATASET] [FLAG]
#   bash launch_grid.sh airfoil_self_noise 0
# 
# Call single job:
# sbatch --export=ALL,DATASET="airfoil_self_noise",N_ITER=16,N_RULES=4,N_INITIAL_RULES=4,FLAG=1 default.sbatch
#
# FLAG selects which script/mode to run:
#   0 -> suprb_default --no-tune
#   1 -> suprb_default --tune
#   2 -> suprb_moo
#   3 -> suprb_ns --use_current_population true
#   4 -> suprb_ns --use_current_population false

set -euo pipefail

DATASET=${1:-"airfoil_self_noise"}  # erstes Argument, default airfoil
FLAG="${2:-0}"   # zweites Argument, 0 notune, 1 tune, 2 moo, 3 ns

LABEL="notune"
[[ "${FLAG}" == "1" ]] && LABEL="tune"
[[ "${FLAG}" == "2" ]] && LABEL="moo"
[[ "${FLAG}" == "3" ]] && LABEL="ns_population_true"
[[ "${FLAG}" == "4" ]] && LABEL="ns_population_false"
            

N_ITER_VALUES=(24)       #(4 8 16 24 32 48 64 96 128)
N_RULES_VALUES=(8)       #(2 4 8 16)
N_INITIAL_RULES_VALUES=(0 8 16 24 32) #(0 8 16 24 32)

mkdir -p stdout


echo "Start Grid for dataset: ${DATASET}"
echo "Grid-size: ${#N_ITER_VALUES[@]} x ${#N_RULES_VALUES[@]} x ${#N_INITIAL_RULES_VALUES[@]} = $((${#N_ITER_VALUES[@]} * ${#N_RULES_VALUES[@]} * ${#N_INITIAL_RULES_VALUES[@]})) Jobs"
echo ""

for n_iter in "${N_ITER_VALUES[@]}"; do
  for n_rules in "${N_RULES_VALUES[@]}"; do
    for n_initial_rules in "${N_INITIAL_RULES_VALUES[@]}"; do
      
      job_name="suprb_${DATASET}_ni${n_iter}_nr${n_rules}_nir${n_initial_rules}_${LABEL}"
      
      sbatch \
        --job-name="${job_name}" \
        --export=ALL,DATASET="${DATASET}",N_ITER="${n_iter}",N_RULES="${n_rules}",N_INITIAL_RULES="${n_initial_rules}",FLAG="${FLAG}" \
        default.sbatch

      echo "  Submitted: ${job_name}"

      sleep 50 
    done
  done
done

echo ""
echo "All Jobs submitted"
